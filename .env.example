# AI Avatar Chat - Environment Configuration

# ==========================================
# BACKEND API (Phase 2 - Recommended)
# ==========================================
# Set USE_BACKEND=true to use the REST API backend instead of direct API calls
# This is more secure as API keys are not exposed in the frontend
USE_BACKEND=false
BACKEND_URL=http://localhost:3000

# ==========================================
# DIRECT API KEYS (Fallback when USE_BACKEND=false)
# ==========================================
# Required if not using backend
KIMI_API_KEY=your_kimi_api_key_here

# Optional - for higher quality TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
