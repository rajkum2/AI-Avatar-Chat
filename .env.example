# AI Avatar Chat - Environment Configuration
# ============================================

# ==========================================
# LLM PROVIDER SELECTION
# ==========================================
# Choose which LLM provider to use:
# - "kimi"        : Kimi API (Moonshot AI) - requires KIMI_API_KEY
# - "ollama"      : Local LLM via Ollama - requires Ollama installed
# - "backend"     : Use backend API server - requires BACKEND_URL
# 
# Default: kimi
LLM_PROVIDER=kimi

# ==========================================
# OPTION 1: OLLAMA (Local LLM - FREE)
# ==========================================
# Requires Ollama installed: https://ollama.com
# 1. Install Ollama
# 2. Run: ollama pull llama3.2:3b
# 3. Set LLM_PROVIDER=ollama
#
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# Recommended Ollama models:
# - llama3.2:1b     : Fastest, smallest (1.3GB)
# - llama3.2:3b     : Good balance (2GB) - DEFAULT
# - phi3:mini       : Microsoft, good quality (1.8GB)
# - gemma2:2b       : Google, compact (1.6GB)
# - qwen2.5:3b      : Alibaba, multilingual (2GB)

# ==========================================
# OPTION 2: BACKEND API SERVER
# ==========================================
# Set up your own backend for multi-user or custom LLM
# See backend/ directory for Node.js implementation
# 
# USE_BACKEND=true
# BACKEND_URL=http://localhost:3000

# ==========================================
# OPTION 3: KIMI API (Cloud - Paid)
# ==========================================
# Get API key from: https://platform.moonshot.cn
# KIMI_API_KEY=your_kimi_api_key_here

# ==========================================
# OPTIONAL: ELEVENLABS TTS (Paid)
# ==========================================
# For higher quality voice than system TTS
# Get API key from: https://elevenlabs.io
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ==========================================
# SELF-HOSTED SERVER (Advanced)
# ==========================================
# For running your own LLM server with vLLM, TGI, etc.
# SELF_HOSTED_URL=http://your-server:8000/v1
# SELF_HOSTED_MODEL=meta-llama/Llama-3.2-3B-Instruct
