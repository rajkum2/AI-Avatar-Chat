# Self-Hosted LLM Server Configuration
# ===================================

# Model Configuration
MODEL_NAME=meta-llama/Llama-3.2-3B-Instruct
QUANTIZATION=awq
MODEL_FILE=llama-3.2-3b-q4_K_M.gguf

# API Security (optional)
API_KEY=your-secure-api-key-here

# GPU Configuration
# Set to "0" for first GPU, "all" for all GPUs, or "0,1" for specific GPUs
CUDA_VISIBLE_DEVICES=all

# Server URLs (for Flutter app)
# Use these URLs in your Flutter app settings
VLLM_URL=http://your-server-ip:8000/v1
TGI_URL=http://your-server-ip:8080/v1
LLAMA_CPP_URL=http://your-server-ip:8081

# Hardware Requirements by Model
# ==============================
# Model              | VRAM  | Quant  | GPU Example
# -------------------|-------|--------|-------------
# Llama 3.2 1B       | 2GB   | Q4     | GTX 1060
# Llama 3.2 3B       | 4GB   | Q4     | GTX 1660
# Llama 3.1 8B       | 8GB   | Q4     | RTX 3070
# Llama 3.1 70B      | 48GB  | Q4     | A6000, 2x A100
# Mixtral 8x7B       | 48GB  | Q4     | A6000, 2x A100
