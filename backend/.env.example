# AI Avatar Chat Backend Configuration

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Security (generate strong random strings for production)
JWT_SECRET=your_jwt_secret_here_change_in_production

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX=100
CHAT_RATE_LIMIT_MAX=20

# Kimi API (Moonshot AI) - Required
KIMI_API_KEY=your_kimi_api_key_here
KIMI_MODEL=moonshot-v1-8k
KIMI_MAX_TOKENS=300

# System prompt for the AI
SYSTEM_PROMPT=You are a friendly, warm AI assistant embodied as an avatar. Keep ALL responses to exactly 2-3 sentences maximum because they will be spoken aloud. Be conversational, natural, and engaging. Never use bullet points, headers, or markdown in your replies. Speak as if having a real voice conversation.

# ElevenLabs API - Optional (for TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2
